# Bu dosya bir SABLONDUR ve commit edilir - icinde gercek anahtar YOKTUR.
# Kendi anahtarini koymak icin bu dosyayi ".env" adiyla kopyala ve doldur.
#
# Anahtari nereden alirsin:
#   https://aistudio.google.com -> sol menu "Get API key" -> "Create API key"
#
# .env dosyasi .gitignore'dadir; GitHub'a asla gitmez.

GEMINI_API_KEY=buraya_kendi_anahtarini_yaz

# --- Istege bagli ayarlar (bos birakilirsa varsayilanlar kullanilir) ---

# Cevabi yazacak model.
# GEMINI_MODEL=gemini-3.6-flash

# Ana model "503 yogun" dondurdugunde sirayla denenecek yedekler.
# GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.8-flash
